<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="16dp"
            android:contentDescription="Back Button"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Community Reports"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Filter Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="All"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/navy_primary"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Pending"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterAssigned"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Assigned"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterResolved"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Resolved"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:backgroundTint="@color/card_stroke"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Reports Count -->
    <TextView
        android:id="@+id/tvReportCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading reports..."
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>

    <!-- Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_water_drop"
            android:alpha="0.4"
            android:contentDescription="Empty state icon"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No reports found"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your submitted water &amp; sanitation reports will appear here"
            android:textSize="13.5sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="6dp"/>

    </LinearLayout>

</LinearLayout>