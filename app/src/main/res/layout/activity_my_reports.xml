<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F4FF">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F3864"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Reports"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Filter Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="All"
                android:textSize="12sp"
                android:backgroundTint="#1F3864"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterPending"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Pending"
                android:textSize="12sp"
                android:backgroundTint="#DDDDDD"
                android:textColor="#333333"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterAssigned"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Assigned"
                android:textSize="12sp"
                android:backgroundTint="#DDDDDD"
                android:textColor="#333333"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFilterResolved"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Resolved"
                android:textSize="12sp"
                android:backgroundTint="#DDDDDD"
                android:textColor="#333333"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Reports Count -->
    <TextView
        android:id="@+id/tvReportCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Loading reports..."
        android:textSize="13sp"
        android:textColor="#888888"
        android:padding="16dp"/>

    <!-- Reports List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@android:drawable/ic_menu_agenda"
            android:alpha="0.3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No reports found"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your submitted reports will appear here"
            android:textSize="14sp"
            android:textColor="#BBBBBB"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</LinearLayout>